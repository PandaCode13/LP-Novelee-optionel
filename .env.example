# Link to the existing Novelee MVP. If omitted, the account CTA points to the beta form.
VITE_MVP_URL=

# HTTPS endpoint accepting POST { "email": string, "consent": true }.
# Return a 2xx response only after the address has been stored successfully.
VITE_BETA_API_URL=

# HTTPS endpoint accepting POST { "action": "login" | "register" | "reset", "email": string,
# and "password" (except reset) plus "consent" (register). Use secure, HttpOnly sessions.
VITE_AUTH_API_URL=

# Optional public contact address used for contact links.
VITE_CONTACT_EMAIL=
